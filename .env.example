# Multi-Agent Collaborative RAG Configuration
# Copy this file to .env and fill in your own values. Never commit the real .env.

# LLM Configuration
# Providers: "openai", "gemini", "anthropic", "groq", "ollama", "mock"
LLM_PROVIDER=mock
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_BASE_URL=

# Embeddings & Reranking (Hugging Face Inference API -- get a free token at
# https://huggingface.co/settings/tokens, "Read" access is enough). Leave
# blank to run with the built-in deterministic/heuristic fallback instead
# (fine for smoke-testing, not for real retrieval quality).
HF_TOKEN=
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=BAAI/bge-reranker-base

# Database Configuration
DATABASE_URL=sqlite:///./data/enterprise_sales.db
DB_TIMEOUT_SECONDS=10
DB_MAX_ROWS=100

# Vector Store (Qdrant). Leave QDRANT_URL as the local path below to run
# with an on-disk vector store, or point it at a Qdrant Cloud cluster URL
# and set QDRANT_API_KEY.
QDRANT_URL=./data/qdrant_storage
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=corporate_documents

# Web Search
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# Agent & Orchestration
MAX_RETRIES=2
CONFIDENCE_THRESHOLD=0.70
ENABLE_STRATEGY_LEARNING=true
STORAGE_PATH=./data

# Observability & LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=multi-agent-rag

# API & Security
JWT_SECRET=change-this-to-a-random-32-char-secret
FRONTEND_ORIGIN=http://localhost:5173
HOST=0.0.0.0
PORT=8001
